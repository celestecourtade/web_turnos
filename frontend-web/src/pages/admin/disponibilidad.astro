---
import MainLayout from "../../layouts/MainLayout.astro"
---

<MainLayout>
  <button id="btn-toggle-sidebar" aria-label="Toggle menu">&#9776;</button>

  <div class="dashboard-container">
    <aside class="sidebar" id="sidebar">
      <h2>Beauty Salon</h2>
      <nav>
        <ul>
          <li><a href="/admin/dashboard">Inicio</a></li>
          <li><a href="/admin/turnos">Turnos</a></li>
          <li><a href="/admin/disponibilidad">Disponibilidad</a></li>
          <li><a href="/admin/usuarios">Usuarios</a></li>
          <li><a href="/">Volver a la página</a></li>
          <li><a href="/admin/logout">Cerrar sesión</a></li>
        </ul>
      </nav>
    </aside>

    <main class="main-content">
      <h1>Disponibilidad</h1>
      <p>Gestiona la disponibilidad de horarios para que los clientes puedan reservar turnos.</p>

      <form class="availability-form">
        <label for="date">Fecha:</label>
        <input type="date" id="date" name="date" required />

        <label for="startTime">Hora inicio:</label>
        <input type="time" id="startTime" name="startTime" required />

        <label for="endTime">Hora fin:</label>
        <input type="time" id="endTime" name="endTime" required />

        <button type="submit">Guardar Disponibilidad</button>
      </form>
    </main>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      font-family: 'Archivo Black', sans-serif;
      overflow-x: hidden;
    }

    #btn-toggle-sidebar {
      display: none;
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 1001;
      font-size: 2rem;
      background: transparent;
      color: #222A3E;
      border: none;
      cursor: pointer;
    }

    .dashboard-container {
      display: flex;
      height: 100vh;
    }

    .sidebar {
      width: 250px;
      background-color: #222A3E;
      color: white;
      padding: 2rem 1rem;
      transition: transform 0.3s ease;
    }

    .sidebar h2 {
      font-family: 'Decorative', cursive;
      color: #c2185b;
      margin-bottom: 2rem;
    }

    .sidebar nav ul {
      list-style: none;
    }

    .sidebar nav ul li {
      margin-bottom: 1.2rem;
    }

    .sidebar nav ul li a {
      color: white;
      text-decoration: none;
      font-weight: 700;
      font-size: 1.1rem;
      transition: color 0.3s ease;
    }

    .sidebar nav ul li a:hover {
      color: #c2185b;
    }

    .main-content {
      flex-grow: 1;
      padding: 3rem 2rem;
      background: #f9f9f9;
      color: #222A3E;
      overflow-y: auto;
      width: 100%;
    }

    .main-content h1 {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .main-content p {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
    }

    form.availability-form {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      max-width: 500px;
      background: white;
      padding: 1.5rem;
      border-radius: 0.5rem;
      box-shadow: 0 0 10px rgba(0,0,0,0.05);
    }

    form.availability-form label {
      flex: 1 1 100%;
      font-weight: 700;
    }

    form.availability-form input {
      flex: 1 1 100%;
      padding: 0.5rem;
      font-size: 1rem;
    }

    form.availability-form button {
      padding: 0.75rem 1.5rem;
      background-color: #c2185b;
      color: white;
      border: none;
      border-radius: 0.3rem;
      font-weight: bold;
      cursor: pointer;
      margin-top: 1rem;
    }

    form.availability-form button:hover {
      background-color: #a01448;
    }

    /* Responsive */
    @media (max-width: 768px) {
      #btn-toggle-sidebar {
        display: block;
      }

      .dashboard-container {
        flex-direction: column;
      }

      .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        transform: translateX(-100%);
        z-index: 1000;
      }

      .sidebar.active {
        transform: translateX(0);
      }

      .main-content {
        padding-top: 4rem;
      }
    }
  </style>

  <script type="module">
    const btnToggle = document.getElementById('btn-toggle-sidebar');
    const sidebar = document.getElementById('sidebar');

    btnToggle.addEventListener('click', () => {
      sidebar.classList.toggle('active');
    });

    sidebar.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 768) {
          sidebar.classList.remove('active');
        }
      });
    });
  </script>
</MainLayout>
