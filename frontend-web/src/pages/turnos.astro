---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reservá tu turno">
  <h1 style="text-align: center;">Reservá tu turno</h1>

  <form id="form-turno" novalidate>
    <label>
      Nombre:
      <input type="text" name="nombre" required />
    </label>

    <label>
      Apellido:
      <input type="text" name="apellido" required />
    </label>

    <label>
      Teléfono:
      <input 
        type="tel" 
        name="telefono" 
        required 
        pattern="^\d{8,}$" 
        placeholder="Sólo números, mínimo 8 dígitos"
        title="Ingrese un número válido con al menos 8 dígitos"
      />
    </label>

    <label>
      Servicio:
      <select name="servicio" required>
        <option value="">Seleccionar</option>
        <option value="corte">Corte</option>
        <option value="peinado">Peinado</option>
        <option value="coloración">Coloración</option>
      </select>
    </label>

    <label>
      Fecha:
      <input type="date" name="fecha" required min="" />
    </label>

    <label>
      Hora:
      <input type="time" name="hora" required />
    </label>

    <button type="submit">Reservar turno</button>
  </form>

  <div id="mensaje-turno"></div>

  <script is:inline>
    const form = document.getElementById('form-turno');
    const mensaje = document.getElementById('mensaje-turno');
    const fechaInput = form.querySelector('input[name="fecha"]');

    // Poner fecha mínima hoy para no aceptar fechas pasadas
    const hoy = new Date().toISOString().split('T')[0];
    fechaInput.min = hoy;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        mensaje.textContent = '❌ Por favor completa correctamente todos los campos.';
        return;
      }

      const formData = new FormData(form);
      const data = {
        nombre: formData.get('nombre'),
        apellido: formData.get('apellido'),
        telefono: formData.get('telefono'),
        servicio: formData.get('servicio'),
        fecha: formData.get('fecha'),
        hora: formData.get('hora')
      };

      try {
        const res = await fetch('http://localhost:4321/turnos', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        const result = await res.json();

        if (res.ok) {
          mensaje.textContent = '✅ Turno reservado con éxito';
          form.reset();
          // Resetear fecha mínima para hoy nuevamente
          fechaInput.min = hoy;
        } else {
          mensaje.textContent = '❌ Error: ' + (result.message || 'al reservar turno');
        }
      } catch (err) {
        mensaje.textContent = '❌ Error de conexión con el servidor';
      }
    });
  </script>

  <style>
    form {
      max-width: 400px;
      margin: auto;
      padding: 1rem;
      border: 1px solid #ccc;
      border-radius: 1rem;
      background: #fff4f8;
    }

    label {
      display: block;
      margin-bottom: 1rem;
    }

    input, select, button {
      width: 100%;
      padding: 0.5rem;
      margin-top: 0.5rem;
      border-radius: 0.5rem;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    button {
      cursor: pointer;
      background-color: #e91e63;
      color: white;
      font-weight: bold;
      border: none;
      transition: background-color 0.3s ease;
    }

    button:hover {
      background-color: #c2185b;
    }

    #mensaje-turno {
      margin-top: 1rem;
      text-align: center;
      font-weight: bold;
      font-size: 1.1rem;
    }
  </style>
</Layout>
