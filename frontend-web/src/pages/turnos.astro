---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reservá tu turno">
  <h1 style="text-align: center;">Reservá tu turno</h1>

  <form id="form-turno" novalidate>
    <label>
      Nombre:
      <input type="text" name="nombre" required />
    </label>

    <label>
      Apellido:
      <input type="text" name="apellido" required />
    </label>

    <label>
      Teléfono:
      <input 
        type="tel" 
        name="telefono" 
        required 
        pattern="[0-9]{8,}" 
        placeholder="Sólo números, mínimo 8 dígitos"
        title="Ingrese un número válido con al menos 8 dígitos"
      />
    </label>

    <label>
      Email:
      <input 
        type="email" 
        name="email" 
        required 
        placeholder="tu@correo.com"
      />
    </label>
    

    <label>
      Servicio:
      <select name="servicio" required>
        <option value="">Seleccionar</option>
        <option value="corte">Corte</option>
        <option value="peinado">Peinado</option>
        <option value="coloración">Coloración</option>
      </select>
    </label>

    <!-- 🎯 Input unificado de fecha y hora -->
    <label>
      Elegí día y horario:
      <input id="datetime-picker" name="datetime" required />
    </label>

    <button type="submit">Reservar turno</button>
  </form>

  <div id="mensaje-turno"></div>

  <!-- ✅ FLATPICKR: Estilos y script -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Configurar Flatpickr
      flatpickr("#datetime-picker", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
        minDate: "today",
        time_24hr: true,
        minuteIncrement: 30,
      });

      const form = document.getElementById('form-turno');
      const mensaje = document.getElementById('mensaje-turno');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        [...form.elements].forEach(el => {
          if (!el.checkValidity()) {
            el.style.border = '2px solid red';
            console.log(`❌ Campo inválido → name: ${el.name}, value: "${el.value}"`);
          } else {
            el.style.border = '';
          }
        });

        if (!form.checkValidity()) {
          mensaje.textContent = '❌ Por favor completa correctamente todos los campos.';
          return;
        }

        const formData = new FormData(form);
        const [fecha, hora] = formData.get('datetime').split(' ');

        const data = {
        nombre: formData.get('nombre'),
        apellido: formData.get('apellido'),
        telefono: formData.get('telefono'),
        email: formData.get('email'), 
        servicio: formData.get('servicio'),
        date: formData.get('datetime')  
        };

        try {
          const res = await fetch('http://localhost:3001/turnos', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });


          const result = await res.json();

          if (res.ok) {
            mensaje.textContent = '✅ Email de confirmacion enviado, revise su correo electronico';
            form.reset();
          } else {
            mensaje.textContent = '❌ Error: ' + (result.message || 'al reservar turno');
          }
        } catch (err) {
          mensaje.textContent = '❌ Error de conexión con el servidor';
        }
      });
    });
  </script>

  <style>
    form {
      max-width: 400px;
      margin: auto;
      padding: 1rem;
      border: 1px solid #ccc;
      border-radius: 1rem;
      background: #fff4f8;
    }

    label {
      display: block;
      margin-bottom: 1rem;
    }

    input, select, button {
      width: 100%;
      padding: 0.5rem;
      margin-top: 0.5rem;
      border-radius: 0.5rem;
      border: 1px solid #ccc;
      font-size: 1rem;
    }

    button {
      cursor: pointer;
      background-color: #e91e63;
      color: white;
      font-weight: bold;
      border: none;
      transition: background-color 0.3s ease;
    }

    button:hover {
      background-color: #c2185b;
    }

    #mensaje-turno {
      margin-top: 1rem;
      text-align: center;
      font-weight: bold;
      font-size: 1.1rem;
    }
  </style>
</Layout>
